<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TOF Turf + Outdoors | Oklahoma City Artificial Turf Installation</title>
  <meta name="description" content="Family-owned artificial turf installation in Oklahoma City. Backyards, putting greens, pet turf, sports fields, and more. Call 918-521-6958." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --white:      #FFFFFF;
      --off-white:  #F8F8F6;
      --light:      #F0EFec;
      --border:     #E4E3DF;
      --slate-100:  #8E8E8E;
      --slate-200:  #5C5C5C;
      --slate-300:  #2E2E2E;
      --ink:        #161616;
      --green:      #1A5C32;
      --green-mid:  #236B3B;
      --gold:       #C49A2A;
      --gold-light: #E0B740;
      --serif:      'Playfair Display', Georgia, serif;
      --sans:       'Manrope', system-ui, sans-serif;
      --nav-h:      72px;
      --r:          4px;
      --max:        1240px;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: var(--sans);
      color: var(--ink);
      background: var(--white);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ─── NAV ─── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      height: var(--nav-h);
      background: rgba(255,255,255,0.97);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center;
      padding: 0 48px;
      gap: 40px;
      transition: box-shadow 0.3s;
    }

    nav.scrolled { box-shadow: 0 2px 24px rgba(0,0,0,0.07); }

    .nav-logo {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none; flex-shrink: 0;
    }

    .nav-logo svg { width: 36px; height: 36px; }

    .nav-logo-text { line-height: 1.15; }
    .nav-logo-text .name {
      font-family: var(--serif); font-size: 0.92rem;
      color: var(--ink); display: block;
    }
    .nav-logo-text .city {
      font-size: 0.6rem; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--slate-100);
      display: block;
    }

    .nav-links {
      display: flex; align-items: center; gap: 28px;
      list-style: none; margin-left: auto;
    }
    .nav-links a {
      font-size: 0.78rem; font-weight: 500;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--slate-200); text-decoration: none;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--ink); }

    .nav-actions { display: flex; align-items: center; gap: 12px; }

    .nav-phone {
      font-size: 0.8rem; font-weight: 600;
      color: var(--slate-200); text-decoration: none;
      letter-spacing: 0.03em; transition: color 0.2s;
    }
    .nav-phone:hover { color: var(--ink); }

    .btn-primary {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--ink); color: var(--white);
      padding: 11px 22px; border-radius: var(--r);
      font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase;
      text-decoration: none; transition: background 0.2s, transform 0.15s;
    }
    .btn-primary:hover { background: var(--slate-300); transform: translateY(-1px); }

    .btn-outline {
      display: inline-flex; align-items: center; gap: 7px;
      background: transparent; color: var(--ink);
      padding: 11px 22px; border-radius: var(--r);
      border: 1.5px solid var(--border);
      font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase;
      text-decoration: none; transition: border-color 0.2s, background 0.2s;
    }
    .btn-outline:hover { border-color: var(--slate-200); background: var(--off-white); }

    .btn-green {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--green); color: var(--white);
      padding: 14px 28px; border-radius: var(--r);
      font-size: 0.82rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase;
      text-decoration: none; transition: background 0.2s;
    }
    .btn-green:hover { background: var(--green-mid); }

    .mob-menu-btn {
      display: none; flex-direction: column; gap: 5px;
      cursor: pointer; background: none; border: none;
      margin-left: auto; padding: 4px;
    }
    .mob-menu-btn span {
      display: block; width: 22px; height: 1.5px;
      background: var(--ink); border-radius: 2px;
    }

    /* ─── HERO ─── */
    .hero {
      margin-top: var(--nav-h);
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: calc(100vh - var(--nav-h));
    }

    .hero-left {
      background: var(--off-white);
      display: flex; flex-direction: column;
      justify-content: center;
      padding: 80px 72px 80px 64px;
    }

    .hero-eyebrow {
      font-size: 0.68rem; font-weight: 600;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--green); margin-bottom: 20px;
      display: flex; align-items: center; gap: 10px;
    }
    .hero-eyebrow::before {
      content: ''; display: block;
      width: 28px; height: 1.5px; background: var(--green);
    }

    .hero h1 {
      font-family: var(--serif);
      font-size: clamp(2.6rem, 4vw, 4.2rem);
      line-height: 1.1; color: var(--ink);
      margin-bottom: 24px;
    }
    .hero h1 em {
      font-style: italic;
      color: var(--slate-100);
    }

    .hero-sub {
      font-size: 1.05rem; font-weight: 300;
      color: var(--slate-200); line-height: 1.75;
      max-width: 420px; margin-bottom: 40px;
    }

    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    .hero-proof {
      margin-top: 56px;
      padding-top: 32px;
      border-top: 1px solid var(--border);
      display: flex; gap: 32px; flex-wrap: wrap;
    }

    .hero-proof-item strong {
      display: block; font-size: 1.5rem;
      font-family: var(--serif); color: var(--ink);
    }
    .hero-proof-item span {
      font-size: 0.72rem; letter-spacing: 0.05em;
      color: var(--slate-100); text-transform: uppercase;
    }

    .hero-right {
      position: relative; overflow: hidden;
    }
    .hero-right img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
      transition: transform 8s ease;
    }
    .hero-right:hover img { transform: scale(1.03); }

    .hero-tag {
      position: absolute; bottom: 32px; left: 32px;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(8px);
      border-radius: var(--r);
      padding: 16px 20px;
      display: flex; align-items: center; gap: 12px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.1);
    }
    .hero-tag-dot {
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--green); flex-shrink: 0;
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(26,92,50,0.4); }
      50%      { box-shadow: 0 0 0 8px rgba(26,92,50,0); }
    }
    .hero-tag p { font-size: 0.8rem; font-weight: 600; color: var(--ink); }
    .hero-tag span { font-size: 0.7rem; color: var(--slate-100); }

    /* ─── TRUST BAR ─── */
    .trust-bar {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 24px 48px;
      display: flex; justify-content: center;
      gap: 48px; flex-wrap: wrap;
    }
    .trust-item {
      display: flex; align-items: center; gap: 9px;
      font-size: 0.78rem; font-weight: 500;
      color: var(--slate-200); letter-spacing: 0.02em;
    }
    .trust-item svg {
      width: 16px; height: 16px;
      stroke: var(--slate-100); fill: none; flex-shrink: 0;
    }

    /* ─── LAYOUT HELPERS ─── */
    section { padding: 100px 48px; }
    .container { max-width: var(--max); margin: 0 auto; }
    .label {
      font-size: 0.67rem; font-weight: 600;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--slate-100); margin-bottom: 14px;
      display: flex; align-items: center; gap: 10px;
    }
    .label::before {
      content: ''; display: block;
      width: 24px; height: 1px; background: var(--border);
    }
    h2.title {
      font-family: var(--serif);
      font-size: clamp(1.9rem, 3.5vw, 3rem);
      line-height: 1.15; color: var(--ink);
      margin-bottom: 18px;
    }
    .body-text {
      font-size: 1rem; color: var(--slate-200);
      line-height: 1.8; max-width: 540px;
    }

    /* ─── INTRO ─── */
    .intro { background: var(--white); }
    .intro .container {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 100px; align-items: center;
    }

    .intro-img { position: relative; }
    .intro-img img {
      width: 100%; height: 520px;
      object-fit: cover; border-radius: 2px; display: block;
    }
    .intro-img-accent {
      position: absolute; bottom: -20px; right: -20px;
      width: 180px; height: 180px;
      background: var(--off-white); border-radius: 2px; z-index: -1;
    }

    .intro-badge {
      position: absolute; top: 24px; right: 24px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r);
      padding: 16px 20px;
      text-align: center;
    }
    .intro-badge strong {
      display: block; font-family: var(--serif);
      font-size: 1.8rem; color: var(--ink);
    }
    .intro-badge span {
      font-size: 0.68rem; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--slate-100);
    }

    .intro-text .body-text { margin-bottom: 20px; }

    .intro-pills {
      display: flex; flex-wrap: wrap; gap: 8px;
      margin: 28px 0;
    }
    .pill {
      background: var(--off-white);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 6px 16px;
      font-size: 0.75rem; font-weight: 500;
      color: var(--slate-200);
    }

    /* ─── SERVICES ─── */
    .services { background: var(--off-white); }
    .services-head {
      display: flex; justify-content: space-between;
      align-items: flex-end; gap: 32px; flex-wrap: wrap;
      margin-bottom: 52px;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      overflow: hidden;
    }

    .svc-card {
      background: var(--white);
      padding: 36px 32px;
      transition: background 0.25s;
      cursor: pointer;
      position: relative;
    }
    .svc-card:hover { background: var(--off-white); }

    .svc-icon {
      width: 44px; height: 44px;
      background: var(--off-white);
      border-radius: var(--r);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 20px;
    }
    .svc-icon svg { width: 22px; height: 22px; stroke: var(--green); fill: none; stroke-width: 1.5; }

    .svc-card h3 {
      font-family: var(--serif); font-size: 1.2rem;
      color: var(--ink); margin-bottom: 10px;
    }
    .svc-card p { font-size: 0.85rem; color: var(--slate-200); line-height: 1.65; }

    .svc-arrow {
      position: absolute; bottom: 28px; right: 28px;
      opacity: 0; transform: translateX(-6px);
      transition: opacity 0.25s, transform 0.25s;
    }
    .svc-arrow svg { width: 18px; height: 18px; stroke: var(--green); fill: none; }
    .svc-card:hover .svc-arrow { opacity: 1; transform: translateX(0); }

    /* ─── PROJECTS ─── */
    .projects { background: var(--white); }
    .projects-head {
      display: flex; justify-content: space-between;
      align-items: flex-end; gap: 24px; flex-wrap: wrap;
      margin-bottom: 40px;
    }

    .mosaic {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: 260px 260px;
      gap: 10px;
    }

    .mosaic-tile { overflow: hidden; position: relative; }
    .mosaic-tile img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
      transition: transform 0.6s ease;
    }
    .mosaic-tile:hover img { transform: scale(1.05); }

    .m1 { grid-column: span 5; grid-row: span 2; }
    .m2 { grid-column: span 4; }
    .m3 { grid-column: span 3; }
    .m4 { grid-column: span 3; }
    .m5 { grid-column: span 4; }
    .m6 { grid-column: span 5; }

    /* ─── WHY ─── */
    .why { background: var(--off-white); }
    .why .container {
      display: grid; grid-template-columns: 1.1fr 1fr;
      gap: 80px; align-items: start;
    }

    .why-features {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 1px; background: var(--border);
      border: 1px solid var(--border);
      margin-top: 36px;
    }
    .why-feat {
      background: var(--white);
      padding: 28px 24px;
    }
    .why-feat-num {
      font-family: var(--serif); font-size: 2rem;
      color: var(--border); margin-bottom: 10px;
      line-height: 1;
    }
    .why-feat h4 {
      font-size: 0.85rem; font-weight: 600;
      color: var(--ink); margin-bottom: 6px;
    }
    .why-feat p { font-size: 0.8rem; color: var(--slate-200); line-height: 1.6; }

    .why-img-stack { display: flex; flex-direction: column; gap: 10px; }
    .why-img-stack img {
      width: 100%; object-fit: cover; display: block;
    }
    .why-img-stack img:first-child { height: 300px; }
    .why-img-stack img:last-child { height: 200px; }

    /* ─── CLEANING ─── */
    .cleaning { background: var(--white); }
    .cleaning .container {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 80px; align-items: center;
    }

    .cleaning-img { position: relative; }
    .cleaning-img img {
      width: 100%; height: 460px;
      object-fit: cover; display: block;
    }
    .cleaning-img-badge {
      position: absolute; bottom: 24px; right: -24px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r);
      padding: 20px 24px;
    }
    .cleaning-img-badge strong {
      display: block; font-family: var(--serif);
      font-size: 1.6rem; color: var(--green);
    }
    .cleaning-img-badge span {
      font-size: 0.7rem; color: var(--slate-100);
      text-transform: uppercase; letter-spacing: 0.08em;
    }

    .cleaning-list {
      list-style: none; margin: 24px 0 32px;
      display: flex; flex-direction: column; gap: 12px;
    }
    .cleaning-list li {
      display: flex; gap: 12px; align-items: flex-start;
      font-size: 0.88rem; color: var(--slate-200); line-height: 1.6;
    }
    .cleaning-list li::before {
      content: ''; width: 5px; height: 5px;
      background: var(--green); border-radius: 50%;
      flex-shrink: 0; margin-top: 8px;
    }

    /* ─── GREEN BAND ─── */
    .green-band {
      background: var(--green);
      padding: 80px 48px;
      text-align: center;
    }
    .green-band h2 {
      font-family: var(--serif);
      font-size: clamp(2rem, 4vw, 3.2rem);
      color: var(--white); margin-bottom: 16px;
    }
    .green-band p {
      font-size: 1rem; color: rgba(255,255,255,0.72);
      max-width: 480px; margin: 0 auto 36px;
      line-height: 1.75;
    }
    .green-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

    .btn-white {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--white); color: var(--green);
      padding: 15px 32px; border-radius: var(--r);
      font-weight: 700; font-size: 0.9rem;
      letter-spacing: 0.03em; text-decoration: none;
      transition: background 0.2s;
    }
    .btn-white:hover { background: var(--off-white); }
    .btn-white-outline {
      display: inline-flex; align-items: center; gap: 8px;
      background: transparent; color: var(--white);
      padding: 15px 32px; border-radius: var(--r);
      border: 1.5px solid rgba(255,255,255,0.4);
      font-weight: 500; font-size: 0.9rem;
      text-decoration: none; transition: border-color 0.2s;
    }
    .btn-white-outline:hover { border-color: var(--white); }

    /* ─── FOOTER ─── */
    footer {
      background: var(--ink); color: var(--white);
      padding: 64px 48px 28px;
    }
    .footer-grid {
      max-width: var(--max); margin: 0 auto;
      display: grid; grid-template-columns: 2fr 1fr 1fr 1.4fr;
      gap: 48px; padding-bottom: 48px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .footer-brand p {
      font-size: 0.83rem; color: rgba(255,255,255,0.45);
      line-height: 1.75; margin: 16px 0 24px; max-width: 260px;
    }
    .footer-social { display: flex; gap: 10px; }
    .footer-social a {
      width: 36px; height: 36px;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: var(--r);
      display: flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,0.45); transition: all 0.2s;
    }
    .footer-social a:hover { border-color: rgba(255,255,255,0.3); color: var(--white); }
    .footer-social svg { width: 15px; height: 15px; fill: currentColor; }

    .footer-col h4 {
      font-size: 0.66rem; letter-spacing: 0.18em;
      text-transform: uppercase; color: rgba(255,255,255,0.3);
      margin-bottom: 18px; font-weight: 600;
    }
    .footer-col ul { list-style: none; }
    .footer-col ul li { margin-bottom: 9px; }
    .footer-col ul li a {
      font-size: 0.83rem; color: rgba(255,255,255,0.5);
      text-decoration: none; transition: color 0.2s;
    }
    .footer-col ul li a:hover { color: var(--white); }
    .footer-contact-item {
      font-size: 0.83rem; color: rgba(255,255,255,0.5);
      line-height: 1.7; margin-bottom: 6px;
    }
    .footer-contact-item a {
      color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s;
    }
    .footer-contact-item a:hover { color: var(--white); }

    .footer-bottom {
      max-width: var(--max); margin: 24px auto 0;
      display: flex; justify-content: space-between;
      align-items: center; flex-wrap: wrap; gap: 12px;
    }
    .footer-bottom p { font-size: 0.72rem; color: rgba(255,255,255,0.25); }
    .footer-bottom a { color: rgba(255,255,255,0.35); text-decoration: none; transition: color 0.2s; }
    .footer-bottom a:hover { color: rgba(255,255,255,0.6); }

    /* ─── ANIMATIONS ─── */
    .reveal {
      opacity: 0; transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .d1 { transition-delay: 0.1s; }
    .d2 { transition-delay: 0.2s; }
    .d3 { transition-delay: 0.3s; }
    .d4 { transition-delay: 0.4s; }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 1024px) {
      nav { padding: 0 24px; }
      section { padding: 72px 24px; }
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-left { padding: 56px 32px; }
      .hero-right { height: 420px; }
      .intro .container, .why .container, .cleaning .container { grid-template-columns: 1fr; gap: 48px; }
      .services-grid { grid-template-columns: 1fr 1fr; }
      .mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
      .m1,.m2,.m3,.m4,.m5,.m6 { grid-column: span 1; grid-row: span 1; height: 240px; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .trust-bar { padding: 20px 24px; gap: 24px; }
    }

    @media (max-width: 768px) {
      .nav-links, .nav-actions { display: none; }
      .mob-menu-btn { display: flex; }
      .hero-left { padding: 40px 24px; }
      .hero h1 { font-size: 2.4rem; }
      .services-grid { grid-template-columns: 1fr; }
      .why-features { grid-template-columns: 1fr; }
      .mosaic { grid-template-columns: 1fr; }
      .m1,.m2,.m3,.m4,.m5,.m6 { height: 220px; }
      .footer-grid { grid-template-columns: 1fr; }
      .footer-bottom { flex-direction: column; text-align: center; }
      .green-band { padding: 64px 24px; }
      .cleaning-img-badge { right: 12px; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav id="nav">
    <a class="nav-logo" href="/">
      <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="14" r="9" stroke="#1A5C32" stroke-width="1.4" fill="none"/>
        <circle cx="24" cy="14" r="9" stroke="#2E2E2E" stroke-width="1.4" fill="none"/>
        <line x1="12" y1="23" x2="12" y2="34" stroke="#1A5C32" stroke-width="1.4"/>
        <line x1="24" y1="23" x2="24" y2="34" stroke="#2E2E2E" stroke-width="1.4"/>
      </svg>
      <div class="nav-logo-text">
        <span class="name">TOF Turf + Outdoors</span>
        <span class="city">Oklahoma City</span>
      </div>
    </a>

    <ul class="nav-links">
      <li><a href="#services">Services</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#cleaning">Turf Care</a></li>
      <li><a href="/gallery">Gallery</a></li>
      <li><a href="/blog">Blog</a></li>
